{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "praxis://tools/write_file/1.0",
  "title": "write_file",
  "type": "object",
  "required": ["path", "content"],
  "properties": {
    "path": {"type": "string", "minLength": 1},
    "content": {"type": "string"},
    "mode": {"enum": ["create", "overwrite"], "default": "overwrite"}
  }
}

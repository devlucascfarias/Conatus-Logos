{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "praxis://tools/shell/2.0",
  "title": "shell",
  "type": "object",
  "required": ["binary", "args"],
  "properties": {
    "binary": {"type": "string", "minLength": 1},
    "args": {"type": "array", "items": {"type": "string"}, "default": []},
    "cwd": {"type": "string", "default": "."},
    "timeout_ms": {
      "type": "integer",
      "minimum": 100,
      "maximum": 30000,
      "default": 10000
    }
  }
}

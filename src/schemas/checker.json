{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "praxis://tools/checker/1.0",
  "title": "checker",
  "type": "object",
  "required": ["language", "operation", "files"],
  "properties": {
    "language": {
      "enum": ["python", "go", "javascript", "typescript", "sql", "shell", "html"]
    },
    "operation": {
      "enum": ["syntax_check", "compile", "compile_and_test", "run", "lint"]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "content"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "content": {"type": "string"}
        }
      }
    },
    "entrypoint": {"type": "string"},
    "timeout_ms": {
      "type": "integer",
      "minimum": 100,
      "maximum": 60000,
      "default": 15000
    }
  }
}

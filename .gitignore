# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
.venv/
venv/

# Outputs de treino/execução (checkpoints, logs, adapters — grandes, não versionados)
outputs/checkpoints/
outputs/logs/
outputs/adapter/
outputs/*.json

# Modelos exportados/mergeados para inferência local (GGUF, zips de adapter) — grandes,
# baixados manualmente do Drive pra raiz do repo durante o trabalho de export/quantização
*.gguf
*.zip

# Notebooks — checkpoints do Jupyter
.ipynb_checkpoints/

# Segredos — nunca versionar valores reais de chave/API (seção 7.8/5.4 do PLAN.md)
.env
*.env.local

# OS
.DS_Store
Thumbs.db

# Estado interno do harness do Claude Code, não faz parte do projeto
.claude/

# Projeto-template do checker Node/React/R3F (D-checker-node-backend) — package.json/lockfile
# são versionados, node_modules/dist não (instalação local via 'npm install', ver README.md)
checker_templates/*/node_modules/
checker_templates/*/dist/

n.sidebar-collapse.collapsed { width: 4.5rem; }\\n.sidebar-collapse .toggle { background: none; border: none; cursor: pointer; font-size: 1rem; margin-bottom: var(--space-lg); color: var(--color-text); }\\n.sidebar-collapse a { display: flex; align-items: center; gap: var(--space-sm); padding: 0.6rem; border-radius: 0.6rem; color: var(--color-text); text-decoration: none; font-size: 0.9rem; white-space: nowrap; }\\n.sidebar-collapse a:hover { background: var(--color-border); }\\n.sidebar-collapse .icon { font-size: 1rem; width: 1.2rem; text-align: center; flex-shrink: 0; }\\n.sidebar-collapse.collapsed .label { display: none; }\\n.shell .content { flex: 1; padding: var(--space-lg); }\\n</style>\\n</head>\\n<body>\\n<section class=\\\"filler\\\">\\n<h1>Conteúdo de exemplo</h1>\\n<p>Esta seção existe só pra dar contexto de página ao componente principal do exemplo.</p>\\n</section>\\n\\n<div class=\\\"shell\\\">\\n<aside class=\\\"sidebar-collapse\\\" id=\\\"sidebar\\\">\\n<button class=\\\"toggle\\\" id=\\\"toggle-btn\\\" type=\\\"button\\\" aria-label=\\\"Alternar barra lateral\\\">&#9776;</button>\\n<a href=\\\"#inicio\\\"><span class=\\\"icon\\\">&#9679;</span><span class=\\\"label\\\">Início</span></a>\\n<a href=\\\"#projetos\\\"><span class=\\\"icon\\\">&#9632;</span><span class=\\\"label\\\">Projetos</span></a>\\n<a href=\\\"#relatorios\\\"><span class=\\\"icon\\\">&#9650;</span><span class=\\\"label\\\">Relatórios</span></a>\\n<a href=\\\"#config\\\"><span class=\\\"icon\\\">&#9881;</span><span class=\\\"label\\\">Configurações</span></a>\\n</aside>\\n<div class=\\\"content\\\"><h2>Conteúdo principal</h2></div>\\n</div>\\n\\n<script>\\nfunction toggleSidebar() {\\n  const sidebar = document.getElementById('sidebar');\\n  sidebar.classList.toggle('collapsed');\\n}\\ndocument.getElementById('toggle-btn').addEventListener('click', toggleSidebar);\\n</script>\\n</body>\\n</html>\\n\"}</tool_call><tool_result name=\"write_file\" status=\"ok\">{\"path\": \"index.htm
r-border); }\\n.pricing { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-lg); max-width: 60rem; margin: 0 auto; padding: 0 var(--space-lg) var(--space-xl); align-items: start; }\\n.plan { border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--space-xl) var(--space-lg); text-align: center; position: relative; }\\n.plan.featured { border: 2px solid var(--color-primary); box-shadow: 0 20px 40px rgba(0, 113, 227, 0.12); transform: scale(1.03); }\\n.plan .badge-featured { position: absolute; top: -0.75rem; left: 50%; transform: translateX(-50%); background: var(--color-primary); color: #fff; font-size: 0.7rem; font-weight: 600; padding: 0.25rem 0.8rem; border-radius: 980px; }\\n.plan h3 { margin: 0 0 var(--space-sm); font-size: 1.1rem; }\\n.plan .price { font-size: 2.5rem; font-weight: 700; margin: var(--space-md) 0; }\\n.plan .price span { font-size: 1rem; font-weight: 400; color: var(--color-muted); }\\n.plan ul { list-style: none; padding: 0; margin: var(--space-lg) 0; text-align: left; }\\n.plan li { padding: 0.4rem 0; color: var(--color-muted); font-size: 0.9rem; }\\n.plan li::before { content: '\\\\2713'; color: var(--color-success); font-weight: 700; margin-right: 0.5rem; }\\n@media (max-width: 720px) { .pricing { grid-template-columns: 1fr; } .plan.featured { transform: none; } }\\n</style>\\n</head>\\n<body>\\n<section class=\\\"filler\\\">\\n<h1>Conteúdo de exemplo</h1>\\n<p>Esta seção existe só pra dar contexto de página ao componente principal do exemplo.</p>\\n</section>\\n\\n<div class=\\\"pricing\\\">\\n<div class=\\\"plan\\\">\\n<h3>Básico</h3>\\n<div class=\\\"price\\\">R$ 29<span>/mês</span></div>\\n<ul>\\n<li>1 projeto ativo</li>\\n<li>5 GB de armazenamento</li>\\n<li>Suporte por e-mail</li>\\n</ul>\\n<button class=\\\"btn btn-secondary\\\" type=\\\"button\\\">Começar</button>\\n</div>\\n<div class=\\\"plan featured\\\">\\n<span class=\\\"badge-featured\\\">Mais popular</span>\\n<h3>Pro</h3>\\n<di